#
# Runs the unit tests and the full build tests (urgent help on every page,
# England and Wales variants, the demo practice).
#
# One-off setup: Node.js 24 (see .nvmrc), then `npm ci`.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ ! -d node_modules ]; then
  echo "Dependencies are not installed. Run: npm ci" >&2
  exit 1
fi

exec npm test -- "$@"
