# SPDX-FileCopyrightText: 2026 Marcus Baw
# SPDX-License-Identifier: MIT
#
# Runs ESLint and the Prettier formatting check. practice/ is deliberately
# excluded from Prettier; npm run check validates it instead.
#
# One-off setup: Node.js 24 (see .nvmrc), then `npm ci`.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ ! -d node_modules ]; then
  echo "Dependencies are not installed. Run: npm ci" >&2
  exit 1
fi

exec npm run lint -- "$@"
