#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Marcus Baw
# SPDX-License-Identifier: MIT
#
# Builds the website into _site/. Set PATH_PREFIX when publishing in a sub
# folder, for example PATH_PREFIX=/open-practice-website/ s/build
#
# One-off setup: Node.js 24 (see .nvmrc), then `npm ci`.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ ! -d node_modules ]; then
  echo "Dependencies are not installed. Run: npm ci" >&2
  exit 1
fi

exec npm run build -- "$@"
